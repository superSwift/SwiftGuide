{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftguide.local/schemas/strategy-schema-v1.json",
  "title": "StrategyConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "schema_version", "universe", "rebalance", "risk"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclude_st", "min_list_days"],
      "properties": {
        "exclude_st": { "type": "boolean" },
        "min_list_days": { "type": "integer", "minimum": 0 }
      }
    },
    "fundamental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roe_min": { "type": "number" },
        "pe_min": { "type": "number" },
        "pe_max": { "type": "number" }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ma_short": { "type": "integer", "minimum": 1 },
        "ma_long": { "type": "integer", "minimum": 1 }
      }
    },
    "rebalance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freq", "hold_count"],
      "properties": {
        "freq": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "hold_count": { "type": "integer", "minimum": 1 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_position"],
      "properties": {
        "max_position": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "stop_loss": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
